          "patch"
        ]
      }
    },
    {
      "name": "things_complete",
      "description": "Complete a to-do by ID or unique title match.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id_or_title": {
            "type": "string"
          },
          "yes": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id_or_title"
        ]
      }
    },
    {
      "name": "things_cancel",
      "description": "Cancel a to-do by ID.",
      "inputSchema": {
        "type": "object",
