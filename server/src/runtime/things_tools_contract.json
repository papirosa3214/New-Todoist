          "notes": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "reminder_time": {
            "type": "string"
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "heading_id": {
            "type": "string"
          },
          "recurrence": {},
          "list": {
            "type": "string",
            "enum": [
              "inbox",
              "today",
              "upcoming",
              "anytime",
              "someday"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "project_id": {
            "type": "string"
          },
          "area_id": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "name": "things_update",
      "description": "Create or update using documented Things URL Scheme. Supports dates, local reminder time, tags, checklist and heading assignment for to-dos; project fields vary. Returns actual x-success receipt, then read to verify fields. For recurrence rules or other UI-only operations use things_ui. Never retry an unconfirmed write without reading first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "patch": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "deadline": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "project_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "area_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "completed",
                  "canceled"
                ]
