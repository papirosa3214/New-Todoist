    {
      "name": "things_list",
      "description": "List to-dos by Things list name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "today",
              "inbox",
              "upcoming",
              "anytime",
              "someday",
              "logbook",
              "trash"
            ]
          }
        },
        "required": [
