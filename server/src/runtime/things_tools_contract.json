        ]
      }
    },
    {
      "name": "things_search",
      "description": "Search Things to-dos by title or notes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "things_get",
      "description": "Read one item by full ID or unique ID prefix.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
