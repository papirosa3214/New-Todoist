          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "things_reopen",
      "description": "Reopen a completed or canceled to-do by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "things_delete",
      "description": "Move a to-do to Things Trash.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "things_show",
      "description": "Reveal a to-do in Things UI.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id_or_title": {
            "type": "string"
          }
        },
        "required": [
          "id_or_title"
        ]
      }
    },
    {
      "name": "things_ui",
      "description": "Things-only macOS interface control, including recurrence and other UI-only settings. Use inspect to obtain snapshot and element IDs, then press/select/set_value/key with that snapshot. Stale UI is rejected. Re-inspect to verify every change. Requires an unlocked Mac session and Accessibility permission. No shell, arbitrary app or desktop access. status checks permissions without changing anything.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "status",
              "inspect",
              "press",
              "select",
              "set_value",
              "key"
            ]
          },
          "snapshot": {
            "type": "string"
          },
          "element": {
            "type": "integer"
          },
          "value": {
            "type": "string"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ]
}
