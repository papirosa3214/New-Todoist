    },
    {
      "name": "things_areas",
      "description": "List Things areas as structured records.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "things_project_add",
      "description": "Create or update using documented Things URL Scheme. Supports dates, local reminder time, tags, checklist and heading assignment for to-dos; project fields vary. Returns actual x-success receipt, then read to verify fields. For recurrence rules or other UI-only operations use things_ui. Never retry an unconfirmed write without reading first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "area_id": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    {
      "name": "things_project_update",
      "description": "Create or update using documented Things URL Scheme. Supports dates, local reminder time, tags, checklist and heading assignment for to-dos; project fields vary. Returns actual x-success receipt, then read to verify fields. For recurrence rules or other UI-only operations use things_ui. Never retry an unconfirmed write without reading first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "patch": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "deadline": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "area_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "completed",
                  "canceled"
                ]
              },
              "start_date": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "patch"
        ]
      }
    },
    {
      "name": "things_add",
      "description": "Create or update using documented Things URL Scheme. Supports dates, local reminder time, tags, checklist and heading assignment for to-dos; project fields vary. Returns actual x-success receipt, then read to verify fields. For recurrence rules or other UI-only operations use things_ui. Never retry an unconfirmed write without reading first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
