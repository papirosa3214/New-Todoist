# Build / runtime artefacts
node_modules/
dist/
build/
.cache/
.vite/
# Compiled server (built by tsc, regenerated on `npm run build`)
server/dist/
# Web build embedded into the iOS app bundle — re-copied by `npm run sync`
ios/App/App/public/assets/
# User-uploaded files (chat attachments, comment files) — kept on disk
# outside the repo so backups only carry code + config.
server/uploads/
test-results/
playwright-report/

# Local state & secrets
.env
.env.local
.env.*.local
# Live SQLite databases (the running server's data) — must NEVER be
# committed; backing them up is a separate concern (see server/scripts/backup.sh).
server/data.db
server/data.db-journal
server/data.db-wal
server/data.db-shm
server/taskflow.db
server/taskflow.db-journal
server/taskflow.db-wal
server/taskflow.db-shm
server/*.state.json
server/agent-watch.state.json
server/chat-watch.state.json
server/trigger-watch.state.json
*.bak
*.bak-*
data.db
data.db-journal

# Tooling state / caches (hundreds of MB locally, useless in git)
.npm-cache/
.dsh-home/
.playwright/
.playwright-mcp/

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp
# macOS metadata litter (starts with `._`; harmless locally, useless in git)
._*
.Spotlight-V100/
.Trashes/
# OS / temp
*.log
*.tmp
.tmp/

# Patch working dirs (kept out of the repo; the patch scripts restore from git)
patch_workspace/

# Claude agent worktrees (separate sub-repos managed by the agent harness —
# never fold into this repo, otherwise git complains about embedded git dirs).
.claude/worktrees/

# Local empty SQLite debug stubs (left over from manual testing)
db.sqlite
zzz.db
server/zzz.db