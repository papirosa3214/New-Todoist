{"type":"before","callId":"call@130","startTime":21199.92,"class":"Frame","method":"evaluateExpression","params":{"expression":"async () => {\n    const token = localStorage.getItem(\"taskflow_token\");\n    const res = await fetch(\"/api/tasks\", {\n      headers: token ? {\n        Authorization: `Bearer ${token}`\n      } : {}\n    });\n    if (!res.ok) return null;\n    const tasks = await res.json();\n    const fit = tasks.find(t => t.status === \"active\" && t.project_id && t.start_time && t.duration_min != null);\n    return fit ? {\n      id: fit.id,\n      title: fit.title,\n      start_time: fit.start_time,\n      duration_min: fit.duration_min,\n      project_name: fit.project_name\n    } : null;\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@50","pageId":"page@d0da2de97dcfea125f0857a46c04cb3e","beforeSnapshot":"before@call@130"}
