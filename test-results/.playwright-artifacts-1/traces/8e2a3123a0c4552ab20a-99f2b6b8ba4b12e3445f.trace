","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-plus","aria-hidden":"true"},["path",{"d":"M5 12h14"}],["path",{"d":"M12 5v14"}]],"Добавить задачу"]]],["DIV",{"data-column-id":"561868e7-02a8-40d2-8691-a117024d9b38","class":"shrink-0 snap-center w-[min(calc(100vw-40px),632px)]"},["DIV",{"class":"flex items-center gap-2 px-1 mb-2 min-h-11"},["SPAN",{"class":"w-2.5 h-2.5 rounded-full shrink-0","style":"background-color: rgb(255, 154, 20);"}],["SPAN",{"class":"text-[13px] font-semibold truncate text-text"},"Домашний сервер"],["DIV",{"class":"ml-auto shrink-0 flex items-center gap-1"},["SPAN",{"class":"text-[11px] text-sub"},"9"]]],["DIV",{},["DIV",{"class":"flex flex-col gap-2"},["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Прибраться на домашней машине и закрыть хвосты"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Накопились мелкие незакрытые дела по .110: пропало распознавание речи, висят процессы от завершённых сессий, просрочен ключ к базе знаний, два сервиса CRM так и не поднимались ни разу.\n\nДва последних пункта — твои, их делать на телефоне: я туда не дотянусь."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","8"]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Хвосты TaskFlow: безопасность, бэкап, служба, база"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Собрано при разборе 14.08.2026 — то, что осталось незакрытым после переезда с Kaneo. Часть проверена живьём на доске.\n\nПорядок по риску: сначала чужой доступ, потом потеря данных, дальше остальное."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"text-[10px] text-sub shrink-0"},"1","/","7"]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"},["IMG",{"__playwright_current_src__":"https://localhost:5180/api/avatars/edfb1767-0708-4d71-9c47-a14595c1d2cc.png","alt":"","class":"rounded-lg shrink-0","src":"/api/avatars/edfb1767-0708-4d71-9c47-a14595c1d2cc.png","style":"width: 24px; height: 24px; object-fit: contain;"}]],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Подобрать анимированные иконки для 4 разделов нижнего меню"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Сейчас в нижнем меню TaskFlow (src/lib/navItems.ts) — статичные чёрно-белые иконки Lucide: «Входящие» (inbox), «Сегодня» (calendarCheck), «Предстоящее» (calendarSmall), «Обзор» (home).\n\nЗадача: найти по одной анимированной иконке под каждый из этих 4 разделов — того же типа, что уже используется в проекте (пример: спиннер «в работе» у подзадач — 12-капельный comet-спиннер, взят как референс с бесплатного стока анимированных иконок, GIF/PNG с прозрачным фоном). Подойдут источники вроде Flaticon Animated Icons, LottieFiles, IconScout Lottie — свободные для использования, компактные (годные для UI-элемента ~20-24px), с прозрачным или легко удаляемым фоном.\n\nНе встраивать в код и не менять navItems.ts самостоятельно — просто подобрать 1-2 варианта на каждый раздел (ссылка или сам файл) и прислать владельцу (Максиму) на согласование, той же процедурой, что уже была с двумя другими иконками в этой сессии: показать вариант(ы) — дождаться подтверждения — только потом менять код.\n\nНе срочно, не сложная — разведочная задача."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0 bg-card2 text-sub"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-calendar-days","aria-hidden":"true"},["path",{"d":"M8 2v3"}],["path",{"d":"M16 2v3"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2"}],["path",{"d":"M3 9h18"}],["path",{"d":"M8 13h.01"}],["path",{"d":"M12 13h.01"}],["path",{"d":"M16 13h.01"}],["path",{"d":"M8 17h.01"}],["path",{"d":"M12 17h.01"}],["path",{"d":"M16 17h.01"}]],"19 авг"],["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[11px] bg-orange/15 text-orange"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-bot","aria-hidden":"true"},["path",{"d":"M12 8V4H8"}],["rect",{"width":"16","height":"12","x":"4","y":"8","rx":"2"}],["path",{"d":"M2 14h2"}],["path",{"d":"M20 14h2"}],["path",{"d":"M15 13v2"}],["path",{"d":"M9 13v2"}]],"заблокировано"]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"TaskFlow: развилки и идеи на потом"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Ничего из этого не делаем, пока ты не скажешь. Первые четыре — развилки: они ждут именно твоего решения, а не работы. Остальное — идеи, которые копим.\n\nОтдельно: «будить живого Клода вместо двойника» сюда не переносил — решение от 07.08 было копить, а не делать."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","11"]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Убрать зависимость CRM от домашней машины"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"CRM живёт на домашнем компьютере: доступность зависит от света, интернета и того, включена ли машина. Копия кода на GitHub залита 07.08 (222 коммита, ничего не затёрлось) — осталось решить, как дальше вести ветки.\n\nСюда же разбор устройства проекта: чтобы ты сам понимал, что на чём держится, а не полагался на объяснения по случаю."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","3"]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"},["IMG",{"__playwright_current_src__":"https://localhost:5180/api/avatars/edfb1767-0708-4d71-9c47-a14595c1d2cc.png","alt":"","class":"rounded-lg shrink-0","src":"/api/avatars/edfb1767-0708-4d71-9c47-a14595c1d2cc.png","style":"width: 24px; height: 24px; object-fit: contain;"}]],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"AI Control Center — реализация (MVP)"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Единый диспетчерский слой поверх TaskFlow, Mnemosyne, базы знаний (kb_query.py + RAGFlow/wiki-base) и агентных харнессов по подписке (Claude Code, DeepSeek Harness). Не вторая инфраструктура — тонкий слой поверх уже работающих систем.\n\nАрхитектурное решение и модель данных: https://claude.ai/code/artifact/64500b83-230c-43bc-80b0-222701285dfd\nКликабельный прототип интерфейса: https://claude.ai/code/artifact/84987da5-95c3-41ea-bf5e-9d88cd831b91\n\nСтек: FastAPI + Postgres + Vite/React (как CRM-Castom и infra-panel), Redis для очереди/event bus. Подзадачи ниже — это разбивка ровно раздела E (MVP 2-4 недели) архитектурного документа, двигаться по ним по одной."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0 bg-card2 text-sub"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-calendar-days","aria-hidden":"true"},["path",{"d":"M8 2v3"}],["path",{"d":"M16 2v3"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2"}],["path",{"d":"M3 9h18"}],["path",{"d":"M8 13h.01"}],["path",{"d":"M12 13h.01"}],["path",{"d":"M16 13h.01"}],["path",{"d":"M8 17h.01"}],["path",{"d":"M12 17h.01"}],["path",{"d":"M16 17h.01"}]],"19 авг"],["SPAN",{"class":"text-[10px] text-sub shrink-0"},"10","/","11"],["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[11px] bg-orange/15 text-orange"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"10","height":"10","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-bot","aria-hidden":"true"},["path",{"d":"M12 8V4H8"}],["rect",{"width":"16","height":"12","x":"4","y":"8","rx":"2"}],["path",{"d":"M2 14h2"}],["path",{"d":"M20 14h2"}],["path",{"d":"M15 13v2"}],["path",{"d":"M9 13v2"}]],"заблокировано"]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Довести CRM до вида, в котором с ней работает менеджер"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"CRM работает, но в ежедневной работе неудобна: данные о клиенте разбросаны по экранам, рабочий стол рисовался под сотни объектов, а на деле их единицы, часть экранов обновляется по таймеру. Входящие обращения из бота никуда не попадают, ставки банков собираем руками.\n\nЦель: менеджер ведёт сделку от обращения до решения банка, не прыгая между экранами и не вбивая одно и то же дважды.\n\nПервый пункт уже в работе, остальные лежали отложенными."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","9"]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Внести изменения в раздел «Предстоящие», а именно нужно добавить два новых вида календаря с различными его раскладками по задачам"]]]]]],["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Добавить несколько видов в разделе «Предстоящие», связанных с отображением задач в календаре в различных раскладках"]]]]]]]],["DIV",{"class":"mt-4"},["BUTTON",{"class":"tap-row w-full flex items-center justify-center gap-2 h-11 rounded-xl border border-dashed border-red/40 bg-red/5 text-[13px] font-semibold text-red"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-plus","aria-hidden":"true"},["path",{"d":"M5 12h14"}],["path",{"d":"M12 5v14"}]],"Добавить задачу"]]],["DIV",{"data-column-id":"c76bb47b-1d22-426e-bb7b-7d6177d0f23e","class":"shrink-0 snap-center w-[min(calc(100vw-40px),632px)]"},["DIV",{"class":"flex items-center gap-2 px-1 mb-2 min-h-11"},["SPAN",{"class":"w-2.5 h-2.5 rounded-full shrink-0","style":"background-color: rgb(255, 122, 138);"}],["SPAN",{"class":"text-[13px] font-semibold truncate text-text"},"Работа"],["DIV",{"class":"ml-auto shrink-0 flex items-center gap-1"},["SPAN",{"class":"text-[11px] text-sub"},"1"]]],["DIV",{},["DIV",{"class":"flex flex-col gap-2"},["DIV",{},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"На подготовить перечень банков, куда я буду заводить сделку по клиенту «Авангард»"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Зафиксировать все свои доступы по банкам, обновить личные кабинеты, скачать информацию о доступных условиях по всем банкам, залить в базу знаний."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0 bg-card2 text-sub"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-calendar-days","aria-hidden":"true"},["path",{"d":"M8 2v3"}],["path",{"d":"M16 2v3"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2"}],["path",{"d":"M3 9h18"}],["path",{"d":"M8 13h.01"}],["path",{"d":"M12 13h.01"}],["path",{"d":"M16 13h.01"}],["path",{"d":"M8 17h.01"}],["path",{"d":"M12 17h.01"}],["path",{"d":"M16 17h.01"}]],"24 авг"],["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","5"],["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0","style":"background-color: rgba(53, 184, 163, 0.15); color: rgb(53, 184, 163);"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-tag","aria-hidden":"true"},["path",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["circle",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}]],"СДЕЛКА"]]]]]]],["DIV",{"class":"mt-4"},["BUTTON",{"class":"tap-row w-full flex items-center justify-center gap-2 h-11 rounded-xl border border-dashed border-red/40 bg-red/5 text-[13px] font-semibold text-red"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-plus","aria-hidden":"true"},["path",{"d":"M5 12h14"}],["path",{"d":"M12 5v14"}]],"Добавить задачу"]]],["DIV",{"data-column-id":"__none","class":"shrink-0 snap-center w-[min(calc(100vw-40px),632px)]"},["DIV",{"class":"flex items-center gap-2 px-1 mb-2 min-h-11"},["SPAN",{"class":"w-2.5 h-2.5 rounded-full shrink-0","style":"background-color: var(--color-dim);"}],["SPAN",{"class":"text-[13px] font-semibold truncate text-text"},"Без проекта"],["DIV",{"class":"ml-auto shrink-0 flex items-center gap-1"},["SPAN",{"class":"text-[11px] text-sub"},"5"]]],["DIV",{},["DIV",{"class":"flex flex-col gap-2"},["DIV",{"style":"transition: transform linear;"},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"тест"]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0 bg-card2 text-sub"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-calendar-days","aria-hidden":"true"},["path",{"d":"M8 2v3"}],["path",{"d":"M16 2v3"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2"}],["path",{"d":"M3 9h18"}],["path",{"d":"M8 13h.01"}],["path",{"d":"M12 13h.01"}],["path",{"d":"M16 13h.01"}],["path",{"d":"M8 17h.01"}],["path",{"d":"M12 17h.01"}],["path",{"d":"M16 17h.01"}]],"19 авг"]]]]],["DIV",{"style":"transition: transform linear;"},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Календарные виды в «Предстоящем» — неделя и месяц"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Как в «Сегодня» появились виды помимо списка (один день, три дня), так в «Предстоящем» добавить неделю и месяц. Основание — четыре скриншота от 19.08.2026 (IMG_8353/8354 — неделя, IMG_8357 — месяц, IMG_8356 — раскрытый день).\n\nКак понял задачу:\n• Неделя — сетка 2×4: первая ячейка целиком занята мини-календарём месяца с подсветкой показанной недели, остальные семь — дни со списком задач (отметка, название, время). Прокрутки в этом виде нет — вся неделя на экране, статика.\n• Месяц — сетка 7×6, в ячейке число и мини-плашки, не влезающие сворачиваются в «+N», листается стрелками.\n• Тап по свободному месту ячейки раскрывает день панелью со списком, тап по плашке открывает задачу.\n• Какой месяц смотрим — подписью под заголовком экрана, с тем же затуханием, что у заголовка.\n• Сетка без замыкающих линий сверху и снизу — раскладка должна читаться продолжающейся, а не запертым квадратом.\n\nРешения, принятые самостоятельно (сказать, если не так):\n• Взята структура скриншотов, но не палитра — там светлая тема чужого приложения, у нас своя тёмная.\n• Неделя начинается с понедельника, а не с воскресенья, как на скриншотах: весь остальной календарь приложения уже так устроен.\n• Список с календарём-лентой остался отдельным видом «Список».\n\nСделано и закоммичено: b8da5a3 (оба вида), db93e30 (правки недели по замечаниям). Проверено в Playwright на 420×912.\n\nОсталось: у недели нет стрелок «предыдущая/следующая» — листается только тапом по числу в мини-календаре. Приёмка — за владельцем на телефоне."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0 bg-card2 text-sub"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-calendar-days","aria-hidden":"true"},["path",{"d":"M8 2v3"}],["path",{"d":"M16 2v3"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2"}],["path",{"d":"M3 9h18"}],["path",{"d":"M8 13h.01"}],["path",{"d":"M12 13h.01"}],["path",{"d":"M16 13h.01"}],["path",{"d":"M8 17h.01"}],["path",{"d":"M12 17h.01"}],["path",{"d":"M16 17h.01"}]],"19 авг"],["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","7"]]]]],["DIV",{"style":"transition: transform linear;"},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"E2E-тесты TaskFlow: покрыть все пользовательские сценарии и прогонять их перед сдачей"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Максим 19.08.2026, по делу: «напиши кучу тестов на всё приложение, пусть детально пробьют по всем возможным паттернам поведения — как пользователь бы пользовался. Я весь день сижу и руками исправляю твои косяки, вместо того чтобы думать над фичами».\n\nПричина, по которой баги доходили до него: мои проверки были функциональными (перешло/не перешло, ширина, opacity), а визуальные и жестовые дефекты — «строка едет не по разделителю», «тап без свайпа сдвигает карточку», «анимация прорисовывается криво в начале жеста» — так не ловятся. Нужны тесты, снимающие состояние КАДРАМИ по ходу жеста и сверяющие геометрию с соседними элементами.\n\nЧто покрыть:\n• Списки: тап открывает задачу, свайп открывает кнопку, тап без движения ничего не двигает, кромки строки совпадают с разделителем, отступы сверху/снизу равны.\n• Доска: карточки, перетаскивание между колонками, отступы, метка проекта.\n• «Сегодня» — вид часов: пул задач без времени, перетаскивание за ручку, прокрутка пальцем с плашки, автопрокрутка, совпадение показанного и записанного времени.\n• «Предстоящее»: список/неделя/месяц, свайп месяцев, раскрытие дня, отсутствие прокрутки, равенство рядов.\n• Форма задачи: барабан времени, лента длительности, сохранение полей, интервал в карточке.\n• Карточка задачи: срок с интервалом, бейдж проекта, подзадачи.\n• Общие инварианты: нет горизонтальной прокрутки, нет ошибок в консоли, вид переживает перезагрузку.\n\nПрогонять весь набор перед тем, как отдавать работу, а не после жалобы."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0 bg-card2 text-sub"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-calendar-days","aria-hidden":"true"},["path",{"d":"M8 2v3"}],["path",{"d":"M16 2v3"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2"}],["path",{"d":"M3 9h18"}],["path",{"d":"M8 13h.01"}],["path",{"d":"M12 13h.01"}],["path",{"d":"M16 13h.01"}],["path",{"d":"M8 17h.01"}],["path",{"d":"M12 17h.01"}],["path",{"d":"M16 17h.01"}]],"20 авг"],["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","9"]]]]],["DIV",{"style":"transition: transform linear;"},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disabled":"false","aria-roledescription":"sortable","aria-describedby":"DndDescribedBy-0","class":"touch-none shrink-0 -my-3 -ml-3 mr-1 px-2 flex items-center justify-center self-stretch text-dim active:text-sub","aria-label":"Перетащить задачу"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"14","height":"14","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-grip-vertical","aria-hidden":"true"},["circle",{"cx":"9","cy":"12","r":"1"}],["circle",{"cx":"9","cy":"5","r":"1"}],["circle",{"cx":"9","cy":"19","r":"1"}],["circle",{"cx":"15","cy":"12","r":"1"}],["circle",{"cx":"15","cy":"5","r":"1"}],["circle",{"cx":"15","cy":"19","r":"1"}]]],["DIV",{"class":"min-w-0 flex-1 flex flex-col gap-1"},["DIV",{"class":"flex items-start gap-3"},["DIV",{"class":"flex flex-col items-center shrink-0 w-[24px] -ml-[6px]"}],["DIV",{"class":"min-w-0 flex-1"},["DIV",{"class":"text-[13px] leading-snug line-clamp-2 text-text"},"Сегодня/календарь: чистый пул задач, мини-карточка при удержании, полулист по тапу"],["DIV",{"class":"text-[11px] text-sub truncate mt-0.5"},"Три отдельные вещи из разговора 19.08.2026 (после приёмки перетаскивания). Прошу сверить формулировки — делать буду в этом порядке.\n\n1. ПУЛ ЗАДАЧ БЕЗ ВРЕМЕНИ («Сегодня» → вид часов) — почистить.\nУбрать шапку пула целиком: иконку из трёх полосок, надпись «Без времени — N» и подсказку «перетащите на шкалу». Остаются только сами плашки задач, парящие поверх сетки; всё вокруг прозрачное — как сейчас и выглядит, но без лишних элементов.\nПри этом на самой плашке информации СЛИШКОМ мало — непонятно, к чему задача относится. Добавить компактно, символами: цвет/точку проекта и флажок приоритета. Конкретный набор — на моё усмотрение, показать и поправить.\n\n2. МИНИ-КАРТОЧКА ПРИ УДЕРЖАНИИ.\nКогда задачу зажали и тащат — рядом всплывает небольшое окно с более полным контекстом (по типу подсказки при наведении курсора): взглянул одним глазом и понял, что это, не проваливаясь в карточку.\n\n3. ПОЛУЛИСТ ПО ТАПУ НА ЗАДАЧУ В КАЛЕНДАРЕ (скриншоты IMG_8374/8375).\nТап по задаче в календаре открывает не сразу полную карточку, а панель снизу — как уже сделано у фильтров. В ней: проект, срок с временем, заметка, название задачи, подзадачи с «добавить подзадачу», внизу строка иконок. Панель выезжает примерно наполовину; если дотянуть её вверх до конца — разворачивается в полную карточку задачи.\n\nОткрытые вопросы к владельцу: какой именно набор символов на плашке пула считать достаточным; нужна ли мини-карточка (п.2) и в календарных видах «Предстоящего» или только в сетке дня."]]],["DIV",{"class":"flex items-center gap-1.5 flex-wrap pl-[26px]"},["SPAN",{"class":"inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] shrink-0 bg-card2 text-sub"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"9","height":"9","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.5","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-calendar-days","aria-hidden":"true"},["path",{"d":"M8 2v3"}],["path",{"d":"M16 2v3"}],["rect",{"x":"3","y":"3","width":"18","height":"18","rx":"2"}],["path",{"d":"M3 9h18"}],["path",{"d":"M8 13h.01"}],["path",{"d":"M12 13h.01"}],["path",{"d":"M16 13h.01"}],["path",{"d":"M8 17h.01"}],["path",{"d":"M12 17h.01"}],["path",{"d":"M16 17h.01"}]],"20 авг"],["SPAN",{"class":"text-[10px] text-sub shrink-0"},"0","/","6"]]]]],["DIV",{"style":"transition: transform linear;"},["BUTTON",{"class":"tap-row w-full text-left bg-card rounded-xl px-3 pb-3 pt-2 flex items-stretch gap-1 "},["DIV",{"role":"button","tabindex":"0","aria-disable