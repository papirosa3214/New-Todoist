+def wait_for_drain(deadline, limit=LIMIT, gap=POLL_GAP):
+    """Ждём, пока число мусорных записей опустится ниже limit (или до дедлайна)."""
+    while True:
+        remaining=deadline-time.time()
+        if remaining<=0:break
+        time.sleep(min(gap,remaining))
