+def drop_stale_records(ids, directory='/run/systemd/sessions'):
+    """Убрать просочившиеся файлы состояния сеансов из /run/systemd/sessions.
+
+    logind держит запись сеанса и в памяти, и файлом в /run/systemd/sessions/.
+    У зависшей сессии файл остаётся, поэтому одна перечитка systemd не помогает:
+    запись возвращается. Файл удаляем только у той записи, которую и так считаем
+    мусором (closing, cgroup сеанса исчезла) — живые сеансы не трогаем.
+    """
+    removed=0
+    for sid in ids:
+        path=Path(directory)/sid
+        try:
+            if path.exists():
+                path.unlink()
+                removed+=1
+        except Exception:pass
+    return removed
