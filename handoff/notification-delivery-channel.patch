+def _telegram_text(source: str, level: str, title: str, text: str) -> str:
+    """Как n8n собирает тревогу: значок, отправитель, заголовок, текст."""
+    icon = _ICONS.get(str(level or "info").lower(), "ℹ️")
+    raw = str(source or "")
+    human = _HUMAN_NAMES.get(raw.lower(), raw)
+    src = f"<b>{human}</b> — " if human else ""
+    head = f"<b>{title}</b>\n" if title else ""
+    return f"{icon} {src}{head}{text}"
+
